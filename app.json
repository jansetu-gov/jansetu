{
  "expo": {
    "name": "JanSetu Gov",
    "slug": "jansetu-gov",
    "scheme": "appdwklvblrbf29",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.miaoda.appdwklvblrbf29",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow JanSetu Gov to use speech recognition for voice search.",
        "NSMicrophoneUsageDescription": "Allow JanSetu Gov to use the microphone for voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appdwklvblrbf29",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow JanSetu Gov to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow JanSetu Gov to use speech recognition for voice search.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow JanSetu Gov to use your location to find the nearest CSC centre."
        }
      ]
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1dc87cb2-3ff2-41d6-be6b-59dc740cc673"
      }
    }
  }
}
